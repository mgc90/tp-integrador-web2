extends ../layout.pug
include ../mixins/commentCard



block metadata
  title= post.title + ' - Fotaza'

block content
  div(class="max-w-4xl mx-auto")
    

    div(class="m-10")
      div(class="p-2")
        div(class="flex items-center gap-2 mb-1")
          

        h2(class="text-white text-3xl font-semibold mb-2")= post.title
        p(class="text-zinc-400 mb-1 flex items-center gap-2")
          if post.User
            span Por #{post.User.firstName} #{post.User.lastName}
            if currentUser && currentUser.id !== post.User.id
              form(method='POST', action='/users/' + post.User.id + '/follow')
                input(type='hidden', name='redirect', value=currentPath)
                if post.User.isFollowing
                  button(class="text-xs bg-zinc-700 text-red-400 px-2 py-0.5 rounded cursor-pointer") Siguiendo
                else
                  button(class="text-xs bg-zinc-700 hover:bg-zinc-600 text-zinc-300 px-2 py-0.5 rounded cursor-pointer") Seguir
        if post.description
          p(class="text-zinc-300 mb-6")= post.description
        if post.Tags && post.Tags.length
          div(class="flex flex-wrap gap-2 mb-6")
            each tag in post.Tags
              span(class="text-red-400/80 text-sm")= '#' + tag.name

        if currentUser
          div(class="flex items-center gap-3 mb-6")
            form(method="POST", action="/posts/" + post.id + "/favorite")
              button(type="submit",
                class="flex items-center gap-1 text-sm px-3 py-1.5 rounded-lg border cursor-pointer transition-colors " +
                (isFavorited
                  ? "border-yellow-500 text-yellow-400 bg-yellow-900/20"
                  : "border-zinc-600 text-zinc-300 hover:border-yellow-500 hover:text-yellow-400"))
                span #{isFavorited ? '★' : '☆'}
                span= isFavorited ? 'En favoritos' : 'Guardar en favoritos'

            - const otherCollections = userCollections ? userCollections.filter(c => !c.isDefault) : []
            if otherCollections.length
              div(class="relative group")
                button(class="flex items-center gap-1 text-sm px-3 py-1.5 rounded-lg border border-zinc-600 text-zinc-300 hover:border-zinc-400 transition-colors cursor-pointer")
                  span Agregar a colección
                  span(class="text-xs ml-1") ▾
                div(class="absolute top-full left-0 mt-1 bg-zinc-800 border border-zinc-600 rounded-lg shadow-lg z-10 hidden group-hover:block min-w-44")
                  each col in otherCollections
                    form(method="POST", action="/collections/" + col.id + "/posts/" + post.id)
                      button(type="submit",
                        class="w-full text-left px-4 py-2 text-sm text-zinc-300 hover:bg-zinc-700 hover:text-white transition-colors cursor-pointer whitespace-nowrap")
                        | #{col.name}

      each image in post.images
        
        
        div(class="bg-zinc-800 rounded-lg overflow-hidden border border-zinc-700 m-8")
          if currentUser || image.license === 'no-copyright'
            img(src=image.url, alt=post.title class="w-full aspect-square object-cover")
          else
            div(class="w-full aspect-square bg-zinc-900 border-b border-zinc-700 flex flex-col items-center justify-center p-6")
              p(class="text-zinc-400 text-5xl text-center px-4") Inicia sesión para ver esta imagen con derechos de autor
              a(href='/auth/login', class="bg-red-600 hover:bg-red-700 text-white text-sm mt-20 px-4 py-2 rounded-lg transition-colors") Iniciar sesión

          div(class="flex items-center gap-2 px-3 py-2 border-t border-zinc-700")
            - const vals = image.Valorations || []
            - const vCount = vals.length
            - const vAvg = vCount ? (vals.reduce((s, v) => s + v.value, 0) / vCount).toFixed(1) : 0
            - const fullStars = Math.round(vAvg)
            each i in [1,2,3,4,5]
              if i <= fullStars
                span(class="text-yellow-400 text-lg") ★
              else
                span(class="text-zinc-600 text-lg") ☆
            if vCount > 0
              span(class="text-zinc-400 text-xs") #{vAvg} (#{vCount})
            else
              span(class="text-zinc-500 text-xs") Sin valoraciones

            if currentUser && post.User && currentUser.id !== post.User.id
              - const userVote = vals.find(v => v.userId === currentUser.id)?.value || null
              if userVote
                span(class="text-yellow-400 text-xs ml-auto") Tu voto: #{userVote}/5
              else
                form(method='POST', action='/posts/' + post.id + '/images/' + image.id + '/rate', class="flex gap-1 ml-auto")
                  each val in [1,2,3,4,5]
                    button(type='submit', name='value', value=val,
                      class="text-zinc-500 hover:text-yellow-400 text-lg cursor-pointer transition-colors") ☆

          if !image.commentsEnabled
            div(class="bg-yellow-900/50 border border-yellow-700 text-yellow-300 rounded-lg p-3 mb-6 text-sm")
              | El autor cerró los comentarios para esta imagen.
          
          div(class="flex items-center justify-between m-1")
            div(class="flex items-center gap-2")
              h4(class="text-zinc-400 text-sm font-medium") Comentarios
              span(class="text-xs text-zinc-500 bg-zinc-700 px-2 py-1 rounded")
                if image.license === 'copyright'
                  | Con Copyright
                else
                  | Sin Copyright
            if currentUser && post.User && currentUser.id !== post.User.id
              form(method='POST', action='/posts/' + post.id + '/images/' + image.id + '/interest')
                button(type='submit',
                  class="text-xs border px-2 py-1 rounded cursor-pointer transition-colors " +
                  (image.userInterested
                    ? "border-red-500 text-red-400 bg-red-900/20"
                    : "border-zinc-600 text-zinc-300 hover:border-red-500 hover:text-red-400"))
                  | #{image.userInterested ? 'Le interesa' : 'Me interesa'}
            if currentUser && post.User && currentUser.id === post.User.id
              span(class="text-xs text-zinc-500") #{image.activeInterestCount} interesado(s)

          if currentUser && post.User && currentUser.id === post.User.id
            if image.commentsEnabled
              form(method='POST', action='/posts/' + post.id + '/images/' + image.id + '/close-comments', class="")
                button(type='submit', class="text-xs text-red-400 hover:text-red-300 cursor-pointer transition-colors m-2") Cerrar comentarios
            else
              form(method='POST', action='/posts/' + post.id + '/images/' + image.id + '/open-comments', class="")
                button(type='submit', class="text-xs text-green-400 hover:text-green-300 cursor-pointer transition-colors m-2") Abrir comentarios

          if image.Comments && image.Comments.length
            div(class="space-y-2 mb-4")
              each comment in image.Comments
                +commentCard(comment, post.User.id, post.id)
          else
            p(class="text-zinc-500 text-sm m-2") Sin comentarios aún.

          if currentUser && image.commentsEnabled
            form(method='POST', action='/posts/' + post.id + '/images/' + image.id + '/comments', class="flex gap-2")
              input(type='text', name='content', required, placeholder='Escribí un comentario...',
                class="flex-1 px-3 py-2 bg-zinc-700 border border-zinc-600 rounded-lg text-white text-sm placeholder-zinc-500 focus:outline-none focus:border-red-500")
              button(type='submit',
                class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm cursor-pointer transition-colors") Comentar
