extends ../layout.pug

block metadata
  title= collection.name + ' - Fotaza'

block content
  div(class="max-w-4xl mx-auto p-6")
    div(class="flex items-center justify-between mb-8")
      div
        div(class="flex items-center gap-3")
          a(href="/collections", class="text-zinc-500 hover:text-zinc-300 transition-colors text-sm")
            | &larr; Mis colecciones
          if collection.isDefault
            span(class="text-yellow-400 text-xs bg-yellow-900/30 px-2 py-1 rounded") Favoritos
        h1(class="text-white text-3xl font-semibold mt-2")= collection.name
        if collection.description
          p(class="text-zinc-400 mt-1")= collection.description
        p(class="text-zinc-500 text-sm mt-1")
          | #{collection.Posts ? collection.Posts.length : 0} publicaciones

    if collection.Posts && collection.Posts.length
      div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4")
        each post in collection.Posts
          div(class="bg-zinc-800 rounded-lg border border-zinc-700 overflow-hidden hover:border-zinc-500 transition-colors")
            a(href="/posts/" + post.id)
              if post.images && post.images[0]
                - const img = post.images[0]
                img(src=img.thumbnailUrl || img.url,
                    alt=post.title,
                    class="w-full aspect-square object-cover")
              else
                div(class="w-full aspect-square bg-zinc-900 flex items-center justify-center")
                  span(class="text-zinc-600") Sin imagen

            div(class="p-3")
              a(href="/posts/" + post.id)
                h3(class="text-white font-medium truncate")= post.title
              if post.User
                p(class="text-zinc-500 text-xs mt-1") por #{post.User.firstName} #{post.User.lastName}

              if post.Tags && post.Tags.length
                div(class="flex flex-wrap gap-1 mt-2")
                  each tag in post.Tags
                    span(class="text-red-400/60 text-xs")= '#' + tag.name

              div(class="mt-3 flex justify-end")
                form(method="POST",
                     action="/collections/" + collection.id + "/posts/" + post.id + "/delete",
                     onsubmit="return confirm('Sacar esta publicación de la colección?')")
                  button(type="submit",
                    class="text-xs text-zinc-500 hover:text-red-400 transition-colors cursor-pointer")
                    | Quitar
    else
      div(class="text-center py-16")
        p(class="text-zinc-500 text-lg") No hay publicaciones en esta colección.
        a(href="/feed", class="text-red-400 hover:text-red-300 transition-colors text-sm mt-2 inline-block")
          | Explorar publicaciones
