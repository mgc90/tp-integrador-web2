include mixins/alert
include mixins/nav


doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(rel="stylesheet", href="/styles/output.css")
    block metadata

  body(class="bg-black shadow-[0_0_40px_10px_rgba(255,255,255,0.8)]")
    +nav
    main
      +alert(alert)

      div(class="m-10 justify-self-center items-center")

        h1(class="text-red-600 text-6xl justify-self-center") Fotaza
        p(class="text-white ") La mejor app para compartir tus imágenes.

        block content

  footer 
    p Fotaza 2026 todos los derechos reservados.