extends layout.pug
include mixins/feed
include mixins/filterByOrderBar

block metadata
  title Siguiendo - Fotaza

block content
  div(class="flex items-center gap-2 mb-6 mt-6 text-sm max-w-7xl mx-auto px-4")
    span(class="text-zinc-400 font-medium") Orden:
    +filterByOrderBar({ sort, baseUrl: '/following' })
  if posts.length === 0
    p(class="text-zinc-500 text-center py-16 text-lg") No hay publicaciones de usuarios que sigues.
  else
    +feed(posts)

