mixin commentCard(comment, postUserId, postId)
  div(class="bg-zinc-700/50 rounded-lg p-3")
    div(class="flex items-center gap-2 text-zinc-400 text-xs mb-1")
      a(href='/users/' + comment.User.id,
        class="font-medium text-zinc-300 hover:text-zinc-100 transition-colors")
        = comment.User ? comment.User.firstName + ' ' + comment.User.lastName : ''
      if currentUser && comment.User && currentUser.id !== comment.User.id
        form(method='POST', action='/users/' + comment.User.id + '/follow')
          input(type='hidden', name='redirect', value=currentPath)
          if comment.User.isFollowing
            button(class="text-xs bg-zinc-700 text-red-400 px-1.5 py-0.5 rounded cursor-pointer") Siguiendo
          else
            button(class="text-xs bg-zinc-700 hover:bg-zinc-600 text-zinc-300 px-1.5 py-0.5 rounded cursor-pointer") Seguir
      span= comment.createdAt ? comment.createdAt.toLocaleDateString() : ''
    p(class="text-zinc-200 text-sm")= comment.content
    if currentUser && currentUser.id === postUserId
      div(class="flex justify-end gap-3 text-xs")
        form(method='POST', action='/posts/' + postId + '/images/' + comment.imageId + '/comments/' + comment.id + '/delete',
          onsubmit="return confirm('¿Seguro que deseas borrar este comentario?')")
          button(type='submit', class="text-zinc-500 hover:text-red-400 transition-colors cursor-pointer") Borrar