extends layout.pug
include mixins/feed
include mixins/filterByOrderBar

block metadata
  title= query ? `"${query}" - Buscar - Fotaza` : 'Buscar - Fotaza'

block content
  div(class="max-w-7xl mx-auto px-4 py-8")
    if query
      h1(class="text-2xl text-white font-semibold mb-1")
        | Resultados para: 
        span(class="text-red-400")= query
      p(class="text-zinc-400 text-sm mb-4")= total + ' resultado(s)'

      - function toggleFilterUrl(filter) {
      -   const others = activeFilters.filter(f => f !== filter)
      -   let url = '/search?q=' + encodeURIComponent(query)
      -   if (others.length) url += '&filter=' + others.map(encodeURIComponent).join('&filter=')
      -   if (!activeFilters.includes(filter)) url += '&filter=' + encodeURIComponent(filter)
      -   if (sort) url += '&sort=' + encodeURIComponent(sort)
      -   return url
      - }

      div(class="flex items-center gap-2 mb-6 text-sm flex-wrap")
        span(class="text-zinc-400 font-medium") Filtrar por:
        each btn in [{ key: 'title', label: 'Título' }, { key: 'author', label: 'Autor' }, { key: 'tag', label: 'Etiqueta' }]
          - var isActive = activeFilters.includes(btn.key)
          a(href=toggleFilterUrl(btn.key),
            class="px-3 py-1.5 rounded-full border transition-colors cursor-pointer " +
            (isActive ? "bg-red-600 border-red-600 text-white" : "border-zinc-600 text-zinc-300 hover:border-zinc-500"))
            = btn.label
        span(class="text-zinc-400 font-medium ml-2") Orden:
        +filterByOrderBar({ sort, query, activeFilters, baseUrl: '/search' })

    if posts.length
      +feed(posts)

      if totalPages > 1
        div(class="flex items-center justify-center gap-2 mt-8")
          if page > 1
            - var prevParams = 'q=' + encodeURIComponent(query) + (activeFilters.length ? '&filter=' + activeFilters.map(encodeURIComponent).join('&filter=') : '') + (sort ? '&sort=' + encodeURIComponent(sort) : '') + '&page=' + (page - 1)
            a(href='/search?' + prevParams, class="px-3 py-1.5 rounded-lg border border-zinc-600 text-zinc-300 hover:border-zinc-400 hover:text-white text-sm transition-colors") Anterior
          - var p = 1
          while p <= totalPages
            - var pageParams = 'q=' + encodeURIComponent(query) + (activeFilters.length ? '&filter=' + activeFilters.map(encodeURIComponent).join('&filter=') : '') + (sort ? '&sort=' + encodeURIComponent(sort) : '') + '&page=' + p
            a(href='/search?' + pageParams,
              class="px-3 py-1.5 rounded-lg border text-sm transition-colors " +
              (p === page ? "bg-red-600 border-red-600 text-white" : "border-zinc-600 text-zinc-300 hover:border-zinc-400 hover:text-white"))= p
            - p++
          if page < totalPages
            - var nextParams = 'q=' + encodeURIComponent(query) + (activeFilters.length ? '&filter=' + activeFilters.map(encodeURIComponent).join('&filter=') : '') + (sort ? '&sort=' + encodeURIComponent(sort) : '') + '&page=' + (page + 1)
            a(href='/search?' + nextParams, class="px-3 py-1.5 rounded-lg border border-zinc-600 text-zinc-300 hover:border-zinc-400 hover:text-white text-sm transition-colors") Siguiente
    else if query
      p(class="text-zinc-500 text-center py-16 text-lg") No se encontraron publicaciones.
