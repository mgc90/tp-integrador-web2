mixin item(path, name, active)
  li
    if active
      a(href=path class='text-red-600 font-medium transition-colors') #{name}
    else
      a(href=path class='text-zinc-300 hover:text-red-400 transition-colors') #{name}

mixin nav
  nav(class="bg-zinc-900 border-b border-zinc-700 px-6 w-screen left-0 right-0 overflow-x-auto")
    div(class="flex-wrap flex items-center justify-between")
      ul(class="flex items-center  py-2 ")
        li: a(href='/' class='text-red-600 text-4xl font-medium transition-colors') Fotaza
      include ../partials/searchBar
      div(class="flex items-center gap-3 py-2 list-none")
        +item('/feed', 'Explorar', currentPath == '/feed')
        if currentUser
          +item('/following', 'Siguiendo', currentPath == '/following')
          li
            a(href='/messages', class=(currentPath.startsWith('/messages') ? 'text-red-600 font-medium transition-colors' : 'text-zinc-300 hover:text-red-400 transition-colors'))
              | Mensajes
              if unreadMessagesCount
                span(class="ml-1 bg-red-600 text-white text-xs px-1.5 py-0.5 rounded-full")= unreadMessagesCount
          li
            a(href='/notifications', class=(currentPath == '/notifications' ? 'text-red-600 font-medium transition-colors' : 'text-zinc-300 hover:text-red-400 transition-colors'))
              | Notificaciones
              if unreadCount
                span(class="ml-1 bg-red-600 text-white text-xs px-1.5 py-0.5 rounded-full")= unreadCount
          +item('/collections', 'Colecciones', currentPath == '/collections')
          +item('/posts/new', 'Publicar', currentPath == '/posts/new')
          if currentUser.rol === 'validator' || currentUser.rol === 'admin'
            +item('/validator', 'Validar', currentPath == '/validator')
          +item('/profile', currentUser.firstName, currentPath == '/profile')
          form(action="/auth/logout", method="post")   
            button(type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg cursor-pointer transition-colors") Salir
        else
          +item('/auth/login', 'Iniciar sesión', currentPath == '/auth/login')
          +item('/auth/signup', 'Registrarse', currentPath == '/auth/signup')
