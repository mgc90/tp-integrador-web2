  "dependencies": {
    "bcrypt": "^6.0.0",
    "browser-sync": "^3.0.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.1.1",
