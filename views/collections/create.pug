extends ../layout.pug

block metadata
  title Nueva colección - Fotaza

block content
  div(class="max-w-lg mx-auto p-6 mt-10")
    h1(class="text-white text-3xl font-semibold mb-8") Nueva colección

    form(method="POST", action="/collections")
      div(class="mb-4")
        label(class="text-zinc-300 text-sm block mb-1") Nombre
        input(type="text", name="name",
          value=formValues ? formValues.name : '',
          class="w-full px-3 py-2 bg-zinc-800 border " + (errors && errors.name ? "border-red-500" : "border-zinc-600") + " rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-red-500")
        if errors && errors.name
          p(class="text-red-400 text-xs mt-1")= errors.name[0]

      div(class="mb-6")
        label(class="text-zinc-300 text-sm block mb-1") Descripción
        textarea(name="description",
          class="w-full px-3 py-2 bg-zinc-800 border border-zinc-600 rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-red-500 resize-none h-24")= formValues ? formValues.description : ''
        if errors && errors.description
          p(class="text-red-400 text-xs mt-1")= errors.description[0]

      div(class="flex items-center gap-3")
        button(type="submit",
          class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg text-sm transition-colors cursor-pointer")
          | Crear colección
        a(href="/collections",
          class="text-zinc-500 hover:text-zinc-300 transition-colors text-sm")
          | Cancelar
