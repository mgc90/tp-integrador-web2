mixin postCard(post, showUser = true)
  article(class="bg-zinc-800 rounded-lg overflow-hidden border border-zinc-700 h-full flex flex-col")
    a(href='/posts/' + post.id, class="flex-1 flex flex-col")
      if post.images[0]
        if currentUser || post.images[0].license === 'no-copyright'
          img(src=post.images[0].url
          alt=post.title
          class="w-full aspect-square object-cover")
        else
          div(class="w-full aspect-square bg-zinc-900 border border-zinc-700 flex flex-col mt-0 items-center justify-center p-4")
            p(class="text-zinc-400 text-3xl my-10 text-center") Imagen con derechos de autor.
            a(href='/auth/login', class="bg-red-600 hover:bg-red-700 text-white text-xs px-3 py-1.5 rounded-lg transition-colors") Iniciar sesión
            

      div(class="p-4 flex-1")
        h3(class="text-white font-semibold truncate")= post.title
        p(class="text-zinc-400 text-sm mt-1 line-clamp-2")= post.description
        if post.Tags && post.Tags.length
          div(class="flex flex-wrap gap-1 mt-2")
            each tag in post.Tags
              span(class="text-zinc-500 text-xs")= '#' + tag.name
    if showUser
      div(class="flex items-center justify-between p-4 pt-0 text-zinc-500 text-xs")
        div(class="flex items-center gap-2")
          span= ("Por " + (post.User && post.User.firstName || '') + ' ' + (post.User && post.User.lastName || '')).trim()
          if currentUser && post.User && currentUser.id !== post.User.id
            form(method='POST', action='/users/' + post.User.id + '/follow')
              input(type='hidden', name='redirect', value=currentPath)
              if post.User.isFollowing
                button(class="text-xs bg-zinc-700 text-red-400 px-1.5 py-0.5 rounded cursor-pointer") Siguiendo
              else
                button(class="text-xs bg-zinc-700 hover:bg-zinc-600 text-zinc-300 px-1.5 py-0.5 rounded cursor-pointer") Seguir
        span= post.createdAt ? post.createdAt.toLocaleDateString() : ''
