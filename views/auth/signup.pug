include ../mixins/alert

doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(rel="stylesheet", href="/styles/output.css")
    title Registrarse

  body(class="bg-black min-h-screen flex items-center justify-center")
    +alert(alert)
    div(class="bg-zinc-900 border border-zinc-700 rounded-2xl p-8 w-full max-w-md shadow-[0_0_30px_5px_rgba(255,255,255,0.1)]")
      h1(class="text-red-600 text-4xl text-center mb-8") Fotaza
      h2(class="text-white text-xl text-center mb-6") Crear cuenta

      form(method='POST', action='/auth/signup')
        - const nombreErr = errors?.nombre?.[0]
        div(class="mb-4")
          label(for='nombre', class="text-zinc-300 block mb-1") Nombre
          input#nombre(type='text', name='nombre', value=formValues ? formValues.nombre : '',
            class="w-full px-4 py-2 bg-zinc-800 border rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-red-500 " +
            (nombreErr ? 'border-red-500' : 'border-zinc-600'))
          if nombreErr
            p(class="text-red-400 text-xs mt-1")= nombreErr

        - const apellidoErr = errors?.apellido?.[0]
        div(class="mb-4")
          label(for='apellido', class="text-zinc-300 block mb-1") Apellido
          input#apellido(type='text', name='apellido', value=formValues ? formValues.apellido : '',
            class="w-full px-4 py-2 bg-zinc-800 border rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-red-500 " +
            (apellidoErr ? 'border-red-500' : 'border-zinc-600'))
          if apellidoErr
            p(class="text-red-400 text-xs mt-1")= apellidoErr

        - const emailErr = errors?.email?.[0]
        div(class="mb-4")
          label(for='email', class="text-zinc-300 block mb-1") Email
          input#email(type='email', name='email', value=formValues ? formValues.email : '',
            class="w-full px-4 py-2 bg-zinc-800 border rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-red-500 " +
            (emailErr ? 'border-red-500' : 'border-zinc-600'))
          if emailErr
            p(class="text-red-400 text-xs mt-1")= emailErr

        - const passErr = errors?.password?.[0]
        div(class="mb-4")
          label(for='password', class="text-zinc-300 block mb-1") Contraseña
          input#password(type='password', name='password',
            class="w-full px-4 py-2 bg-zinc-800 border rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-red-500 " +
            (passErr ? 'border-red-500' : 'border-zinc-600'))
          if passErr
            p(class="text-red-400 text-xs mt-1")= passErr

        - const confirmErr = errors?.confirmPassword?.[0]
        div(class="mb-6")
          label(for='confirmPassword', class="text-zinc-300 block mb-1") Confirmar contraseña
          input#confirmPassword(type='password', name='confirmPassword',
            class="w-full px-4 py-2 bg-zinc-800 border rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-red-500 " +
            (confirmErr ? 'border-red-500' : 'border-zinc-600'))
          if confirmErr
            p(class="text-red-400 text-xs mt-1")= confirmErr

        button(type='submit',
          class="w-full bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded-lg transition-colors cursor-pointer") Crear cuenta

      p(class="text-zinc-400 text-center mt-6")
        | ¿Ya tienes cuenta?
        a(href='/auth/login', class="text-red-500 hover:text-red-400 ml-1") Inicia sesión
