extends layout.pug
include mixins/feed
include mixins/filterByOrderBar

block metadata
  title= query ? `"${query}" - Buscar - Fotaza` : 'Buscar - Fotaza'

block content
  div(class="max-w-7xl mx-auto px-4 py-8")
    if query
      h1(class="text-2xl text-white font-semibold mb-1")
        | Resultados para: 
        span(class="text-red-400")= query
      p(class="text-zinc-400 text-sm mb-4")= count + ' resultado(s)'

      - function toggleFilterUrl(filter) {
      -   const others = activeFilters.filter(f => f !== filter)
      -   let url = '/search?q=' + encodeURIComponent(query)
      -   if (others.length) url += '&filter=' + others.map(encodeURIComponent).join('&filter=')
      -   if (!activeFilters.includes(filter)) url += '&filter=' + encodeURIComponent(filter)
      -   if (sort) url += '&sort=' + encodeURIComponent(sort)
      -   return url
      - }

      div(class="flex items-center gap-2 mb-6 text-sm flex-wrap")
        span(class="text-zinc-400 font-medium") Filtrar por:
        each btn in [{ key: 'title', label: 'Título' }, { key: 'author', label: 'Autor' }, { key: 'tag', label: 'Etiqueta' }]
          - var isActive = activeFilters.includes(btn.key)
          a(href=toggleFilterUrl(btn.key),
            class="px-3 py-1.5 rounded-full border transition-colors cursor-pointer " +
            (isActive ? "bg-red-600 border-red-600 text-white" : "border-zinc-600 text-zinc-300 hover:border-zinc-500"))
            = btn.label
        span(class="text-zinc-400 font-medium ml-2") Orden:
        +filterByOrderBar({ sort, query, activeFilters, baseUrl: '/search' })

    if posts.length
      +feed(posts)
    else if query
      p(class="text-zinc-500 text-center py-16 text-lg") No se encontraron publicaciones.
